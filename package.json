{
  "name": "untangle",
  "version": "0.4.0",
  "description": "JavaScript deobfuscator for malware reversing: restringer-style AST transforms plus sandboxed evaluation",
  "keywords": [
    "deobfuscator",
    "deobfuscation",
    "javascript",
    "malware",
    "reverse-engineering",
    "obfuscator.io",
    "wsh",
    "ast"
  ],
  "author": "CtxtArc",
  "license": "MIT",
  "homepage": "https://github.com/CtxtArc/untangle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CtxtArc/untangle.git"
  },
  "bugs": {
    "url": "https://github.com/CtxtArc/untangle/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./blobs": "./src/blobs.js",
    "./input": "./src/input.js"
  },
  "bin": {
    "untangle": "bin/untangle.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "samples": "node samples/build-obfuscated.mjs && node samples/build-packed.mjs && node samples/build-wsh-ps1.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "escodegen": "^2.1.0",
    "eslint-scope": "^9.1.0",
    "eslint-visitor-keys": "^5.0.0",
    "espree": "^11.0.0"
  },
  "devDependencies": {
    "eslint": "^10.0.0"
  }
}
